      "source": [
        "#@title Generación de Datos Sintéticos Financieros del Contexto Ecuatoriano\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from faker import Faker\n",
        "import random\n",
        "from datetime import datetime, timedelta\n",
        "\n",
        "# Inicializar Faker con localización en español (para nombres realistas)\n",
        "fake = Faker('es_ES')\n",
        "Faker.seed(42)\n",
        "np.random.seed(42)\n",
        "random.seed(42)\n",
        "\n",
        "# Parámetros de la simulación\n",
        "NUM_REGISTROS = 50000  # Tamaño del lote de simulación\n",
        "\n",
        "# Catálogos del contexto ecuatoriano\n",
        "PROVINCIAS = ['Pichincha', 'Guayas', 'Azuay', 'Manabí', 'El Oro', 'Tungurahua', 'Loja', 'Imbabura']\n",
        "BANCOS_LOCALES = ['Banco Pichincha', 'Banco Guayaquil', 'Produbanco', 'Banco del Pacífico', 'Banco Bolivariano', 'Cooperativa JEP']\n",
        "COMERCIOS = ['Supermaxi', 'Mi Comisariato', 'Fybeca', 'Sana Sana', 'De Prati', 'Marathon Sports', 'Gasolinera Primax', 'Uber Ecuador', 'PedidosYa']\n",
        "\n",
        "# Listas para almacenar datos\n",
        "datos = []\n",
        "\n",
        "start_date = datetime(2023, 1, 1)\n",
        "\n",
        "for i in range(NUM_REGISTROS):\n",
        "    # ID único\n",
        "    tx_id = f\"TX-{1000000 + i}\"\n",
        "\n",
        "    # Fecha y hora dentro de un rango\n",
        "    tx_time = start_date + timedelta(\n",
        "        days=random.randint(0, 90),\n",
        "        hours=random.randint(0, 23),\n",
        "        minutes=random.randint(0, 59),\n",
        "        seconds=random.randint(0, 59)\n",
        "    )\n",
        "\n",
        "    cliente_id = f\"CLI-{random.randint(10000, 15000)}\"\n",
        "    provincia = random.choice(PROVINCIAS)\n",
        "    canal = random.choice(['Banca Web', 'App Móvil', 'Cajero Automático', 'POS', 'Ventanilla'])\n",
        "\n",
        "    # Comportamiento normal de montos\n",
        "    if canal in ['Cajero Automático', 'POS']:\n",
        "        monto = round(random.uniform(5.0, 200.0), 2)  # Montos diarios pequeños/medianos\n",
        "    else:\n",
        "        monto = round(random.uniform(10.0, 1500.0), 2)\n",
        "\n",
        "    banco_destino = random.choice(BANCOS_LOCALES)\n",
        "    comercio = random.choice(COMERCIOS) if canal in ['POS', 'Banca Web'] else 'Ninguno'\n",
        "\n",
        "    # Definir anomalía de manera heurística (simulación de fraude)\n",
        "    # Regla de fraude 1: Montos extremadamente altos a altas horas de la madrugada (01:00 - 05:00)\n",
        "    # Regla de fraude 2: Patrón inusual en transacciones rápidas desde provincias distintas en corto tiempo (simplificado aquí por aleatoriedad controlada)\n",
        "    es_anomalia = 0\n",
        "    hora = tx_time.hour\n",
        "\n",
        "    if (hora >= 1 and hora <= 4 and monto > 800.0 and random.random() < 0.7):\n",
        "        es_anomalia = 1\n",
        "    elif (monto > 4500.0 and random.random() < 0.5):  # Montos inusualmente gigantescos para banca digital estándar\n",
        "        es_anomalia = 1\n",
        "    elif (canal == 'App Móvil' and provincia == 'Guayas' and monto > 1200.0 and random.random() < 0.05):\n",
        "        es_anomalia = 1\n",
        "\n",
        "    # Asegurar una tasa de anomalía aproximada de 0.5% (típico en fraude financiero altamente desbalanceado)\n",
        "    if es_anomalia == 0 and random.random() < 0.002:\n",
        "        es_anomalia = 1\n",
        "\n",
        "    datos.append({\n",
        "        'ID_Transaccion': tx_id,\n",
        "        'Fecha_Hora': tx_time,\n",
        "        'Cliente_ID': cliente_id,\n",
        "        'Monto_USD': monto,\n",
        "        'Provincia': provincia,\n",
        "        'Canal': canal,\n",
        "        'Banco_Destino': banco_destino,\n",
        "        'Comercio': comercio,\n",
        "        'Hora_Dia': hora,\n",
        "        'Es_Anomalia': es_anomalia\n",
        "    })\n",
        "\n",
        "# Crear el DataFrame\n",
        "df = pd.DataFrame(datos)\n",
        "\n",
        "# Mostrar estadísticas básicas y proporción de clases\n",
        "print(f\"Dataset generado exitosamente con {len(df)} registros.\")\n",
        "print(f\"Cantidad de Anomalías detectadas en la simulación: {df['Es_Anomalia'].sum()} ({round(df['Es_Anomalia'].mean()*100, 3)}%)\")\n",
        "display(df.head())"
      ],
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
