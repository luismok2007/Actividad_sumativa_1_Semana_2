      "source": [
        "#@title Comparación con Enfoque Supervisado (Random Forest Balanceado)\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "print(\"Entrenando Random Forest balanceado...\")\n",
        "t0 = time.time()\n",
        "rf_model = RandomForestClassifier(n_estimators=100, class_weight='balanced', random_state=42, n_jobs=-1)\n",
        "rf_model.fit(X_train, y_train)\n",
        "tiempo_entrenamiento_rf = time.time() - t0\n",
        "\n",
        "# Inferencia y toma de tiempos\n",
        "t0 = time.time()\n",
        "y_pred_rf = rf_model.predict(X_test)\n",
        "latencia_rf = (time.time() - t0) * 1000  # Latencia en ms\n",
        "\n",
        "# Evaluamos el modelo\n",
        "evaluar_modelo(y_test, y_pred_rf, rf_model.predict_proba(X_test)[:, 1], 'Random Forest (Supervisado)', latencia_rf)\n",
        "\n",
        "# Actualizar tabla comparativa de resultados\n",
        "df_comparativo = pd.DataFrame(resultados_modelos).T\n",
        "print(\"\\n=== TABLA COMPARATIVA DE RESULTADOS FINAL ===\")\n",
        "display(df_comparativo)"
      ],
