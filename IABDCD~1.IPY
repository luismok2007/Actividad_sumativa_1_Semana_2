      "source": [
        "import shap\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Inicializar el explicador SHAP para modelos basados en árboles (TreeExplainer)\n",
        "explainer = shap.TreeExplainer(rf_model)\n",
        "\n",
        "# Calculamos los valores SHAP para una muestra representativa del conjunto de prueba\n",
        "# Usamos una muestra de 500 registros para optimizar el tiempo de cómputo en la simulación\n",
        "X_test_sample = X_test.sample(500, random_state=42)\n",
        "shap_values = explainer.shap_values(X_test_sample)\n",
        "\n",
        "# En scikit-learn RandomForest, shap_values puede devolver una lista para cada clase.\n",
        "# Tomamos los valores SHAP correspondientes a la clase 1 (Anomalía/Fraude).\n",
        "if isinstance(shap_values, list):\n",
        "    shap_values_class1 = shap_values[1]\n",
        "else:\n",
        "    # Para versiones más recientes de SHAP o salidas simplificadas\n",
        "    shap_values_class1 = shap_values[..., 1] if len(shap_values.shape) == 3 else shap_values\n",
        "\n",
        "# Generar el gráfico de resumen de SHAP (Summary Plot)\n",
        "plt.figure(figsize=(10, 6))\n",
        "shap.summary_plot(shap_values_class1, X_test_sample, plot_type=\"bar\", show=False)\n",
        "plt.title('Importancia de Variables según Valores SHAP (Clase: Anomalía)', fontsize=14, pad=15)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "/tmp/ipykernel_3370/2594440263.py:22: FutureWarning: The NumPy global RNG was seeded by calling `np.random.seed`. In a future version this function will no longer use the global RNG. Pass `rng` explicitly to opt-in to the new behaviour and silence this warning.\n",
            "  shap.summary_plot(shap_values_class1, X_test_sample, plot_type=\"bar\", show=False)\n"
          ]
        },
