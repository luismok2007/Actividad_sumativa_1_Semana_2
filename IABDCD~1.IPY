antic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Latencia Inferencia (ms)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 266.0358924406003,\n        \"min\": 77.3,\n        \"max\": 651.75,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          316.04,\n          101.35,\n          77.3\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
