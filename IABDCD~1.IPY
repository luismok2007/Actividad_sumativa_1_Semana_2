      "source": [
        "#@title Pipeline de Preprocesamiento y Divisi\u0001n de Datos\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "import numpy as np\n",
        "\n",
        "# 1. Selecci\u0001n de variables de inter\u0001s\n",
        "features_categoricas = ['Provincia', 'Canal', 'Banco_Destino', 'Comercio']\n",
        "features_numericas = ['Monto_USD', 'Hora_Dia']\n",
        "\n",
        "# Separaci\u0001n de caracter\u0001sticas (X) y etiqueta objetivo (y)\n",
        "X_raw = df[features_categoricas + features_numericas]\n",
        "y = df['Es_Anomalia'].values\n",
        "\n",
        "# 2. Codificaci\u0001n One-Hot para variables categ\u0001ricas\n",
        "X_encoded = pd.get_dummies(X_raw, columns=features_categoricas, drop_first=True)\n",
        "\n",
        "# 3. Divisi\u0001n de datos en Entrenamiento (80%) y Prueba (20%)\n",
        "X_train_raw, X_test_raw, y_train, y_test = train_test_split(\n",
        "    X_encoded, y, test_size=0.20, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "# 4. Estandarizaci\u0001n de las variables num\u0001ricas continuas\n",
        "scaler = StandardScaler()\n",
        "columnas_numericas_encoded = [col for col in X_encoded.columns if any(num_feat in col for num_feat in features_numericas)]\n",
        "\n",
        "X_train = X_train_raw.copy()\n",
        "X_test = X_test_raw.copy()\n",
        "\n",
        "X_train[columnas_numericas_encoded] = scaler.fit_transform(X_train_raw[columnas_numericas_encoded])\n",
        "X_test[columnas_numericas_encoded] = scaler.transform(X_test_raw[columnas_numericas_encoded])\n",
        "\n",
        "print(\"=== RESUMEN DEL PIPELINE DE PREPROCESAMIENTO ===\")\n",
        "print(f\"Dimensiones de X de entrenamiento: {X_train.shape}\")\n",
        "print(f\"Dimensiones de X de prueba: {X_test.shape}\")\n",
        "print(f\"Proporci\u0001n de anomal\u0001as en Entrenamiento: {np.mean(y_train)*100:.3f}%\")\n",
        "print(f\"Proporci\u0001n de anomal\u0001as en Prueba: {np.mean(y_test)*100:.3f}%\")"
