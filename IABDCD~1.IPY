    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "33ab090a",
        "outputId": "46fb60ae-5b65-44df-e9b9-b3737d5b015e"
      },
      "source": [
        "#@title Análisis Exploratorio de Datos (EDA)\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Configuración de gráficos\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
        "\n",
        "# 1. Distribución de clases (Anomalías vs Normales)\n",
        "sns.countplot(x='Es_Anomalia', data=df, ax=axes[0, 0], palette='viridis')\n",
        "axes[0, 0].set_title('Distribución de Clases (0: Normal, 1: Anomalía)')\n",
        "axes[0, 0].set_xlabel('Clase')\n",
        "axes[0, 0].set_ylabel('Frecuencia')\n",
        "for p in axes[0, 0].patches:\n",
        "    axes[0, 0].annotate(f'{p.get_height()}\\n({p.get_height()/len(df)*100:.2f}%)',\n",
        "                        (p.get_x() + p.get_width() / 2., p.get_height()),\n",
        "                        ha='center', va='center', xytext=(0, 10), textcoords='offset points')\n",
        "\n",
        "# 2. Distribución de los montos por Clase\n",
        "sns.boxplot(x='Es_Anomalia', y='Monto_USD', data=df, ax=axes[0, 1], palette='Set2')\n",
        "axes[0, 1].set_title('Distribución de Montos por Clase')\n",
        "axes[0, 1].set_xlabel('Es Anomalía')\n",
        "axes[0, 1].set_ylabel('Monto (USD)')\n",
        "\n",
        "# 3. Transacciones por hora del día según su clase\n",
        "sns.histplot(data=df, x='Hora_Dia', hue='Es_Anomalia', multiple='stack', bins=24, ax=axes[1, 0], palette='magma')\n",
        "axes[1, 0].set_title('Volumen de Transacciones por Hora del Día')\n",
        "axes[1, 0].set_xlabel('Hora del Día')\n",
        "axes[1, 0].set_ylabel('Cantidad de Transacciones')\n",
        "\n",
        "# 4. Transacciones por Provincia\n",
        "sns.countplot(y='Provincia', hue='Es_Anomalia', data=df, ax=axes[1, 1], palette='coolwarm')\n",
        "axes[1, 1].set_title('Transacciones por Provincia y Clase')\n",
        "axes[1, 1].set_xlabel('Frecuencia')\n",
        "axes[1, 1].set_ylabel('Provincia')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Estadísticos descriptivos numéricos\n",
        "print(\"=== ESTADÍSTICAS DESCRIPTIVAS DE TRANSACCIONES NORMALES ===\")\n",
        "display(df[df['Es_Anomalia'] == 0][['Monto_USD', 'Hora_Dia']].describe())\n",
        "\n",
        "print(\"\\n=== ESTADÍSTICAS DESCRIPTIVAS DE TRANSACCIONES ANÓMALAS ===\")\n",
        "display(df[df['Es_Anomalia'] == 1][['Monto_USD', 'Hora_Dia']].describe())"
      ],
      "execution_count": 4,
