      "source": [
        "#@title Fase 4: Explicabilidad del Modelo (Importancia de Variables)\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Extracción de importancias del modelo Random Forest\n",
        "importancias = rf_model.feature_importances_\n",
        "indices = np.argsort(importancias)[::-1]\n",
        "\n",
        "# Tomar las 10 características más relevantes\n",
        "top_n = 10\n",
        "top_indices = indices[:top_n]\n",
        "top_importances = importancias[top_indices]\n",
        "columnas_nombres = [X_train.columns[i] for i in top_indices]\n",
        "\n",
        "# Graficar la importancia de características\n",
        "plt.figure(figsize=(12, 6))\n",
        "plt.barh(range(top_n), top_importances, align='center', color='teal')\n",
        "plt.yticks(range(top_n), columnas_nombres)\n",
        "plt.gca().invert_yaxis()  # Poner la más importante arriba\n",
        "plt.xlabel('Importancia Relativa (Gini Importance)')\n",
        "plt.title('Top 10 Variables más Influyentes en la Detección de Transacciones Anómalas (Fraude)')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
