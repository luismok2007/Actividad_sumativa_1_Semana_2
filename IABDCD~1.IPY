    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 600
        },
        "id": "aa1886cb",
        "outputId": "23cf3e70-8a84-4a33-ff7f-2fbe56bc6b80"
      },
      "source": [
        "#@title Fase 3: Gráfica Ilustrativa de Latencia vs. Throughput según el Batch Size\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Simulación de tamaños de lote para el motor de streaming (ej. Spark Streaming / Flink)\n",
        "tamanyos_lote = np.array([100, 500, 1000, 2000, 5000, 10000, 15000, 20000])\n",
        "\n",
        "# La latencia de red e infraestructura tiene un costo base, y el tiempo de predicción escala con el tamaño del lote\n",
        "latencia_base_ms = 20.0  # Costo base de serialización/red de Kafka\n",
        "tiempo_prediccion_por_tx = 101.35 / 10000  # Obtenido de nuestra medición de Random Forest (0.0101 ms por registro)\n",
        "\n",
        "latencias_estimadas = latencia_base_ms + (tamanyos_lote * tiempo_prediccion_por_tx)\n",
        "throughput_estimado = (tamanyos_lote / (latencias_estimadas / 1000.0))  # Transacciones por segundo (TPS)\n",
        "\n",
        "# Crear gráfico de doble eje\n",
        "fig, ax1 = plt.subplots(figsize=(10, 6))\n",
        "\n",
        "color = 'tab:red'\n",
        "ax1.set_xlabel('Tamaño del Lote (Batch Size - número de transacciones)')\n",
        "ax1.set_ylabel('Latencia de Procesamiento (ms)', color=color)\n",
        "ax1.plot(tamanyos_lote, latencias_estimadas, color=color, marker='o', linewidth=2, label='Latencia (ms)')\n",
        "ax1.tick_params(axis='y', labelcolor=color)\n",
        "ax1.axhline(y=500, color='r', linestyle='--', alpha=0.7, label='Límite SB (500 ms)')\n",
        "\n",
        "ax2 = ax1.twinx()\n",
        "color = 'tab:blue'\n",
        "ax2.set_ylabel('Throughput (Transacciones por Segundo - TPS)', color=color)\n",
        "ax2.plot(tamanyos_lote, throughput_estimado, color=color, marker='s', linewidth=2, label='Throughput (TPS)')\n",
        "ax2.tick_params(axis='y', labelcolor=color)\n",
        "\n",
        "plt.title('Compromiso Técnico: Latencia vs. Throughput en Detección de Fraude en Streaming')\n",
        "fig.tight_layout()\n",
        "ax1.legend(loc='upper left')\n",
        "ax2.legend(loc='upper right')\n",
        "plt.show()"
      ],
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "display_data",
