    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 196
        },
        "id": "a028df6e",
        "outputId": "48fc1769-be0b-438a-9090-48e4e817f4e1"
      },
      "source": [
        "#@title Fase 2: Implementación de Modelos de Detección de Anomalías\n",
        "import time\n",
        "from sklearn.ensemble import IsolationForest\n",
        "from sklearn.svm import OneClassSVM\n",
        "from sklearn.metrics import precision_recall_fscore_support, roc_auc_score, precision_recall_curve, auc\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Model\n",
        "from tensorflow.keras.layers import Input, Dense\n",
        "from tensorflow.keras.callbacks import EarlyStopping\n",
        "\n",
        "# Diccionario para almacenar las métricas\n",
        "resultados_modelos = {}\n",
        "\n",
        "# Definir proporción esperada de contaminación (anomalías)\n",
        "contaminacion = float(np.mean(y_train))\n",
        "\n",
        "# --- 1. MODELO: ISOLATION FOREST ---\n",
        "print(\"Entrenando Isolation Forest...\")\n",
        "t0 = time.time()\n",
        "iso_forest = IsolationForest(contamination=contaminacion, random_state=42, n_jobs=-1)\n",
        "iso_forest.fit(X_train)\n",
        "tiempo_entrenamiento_if = time.time() - t0\n",
        "\n",
        "# Inferencia y toma de tiempos\n",
        "t0 = time.time()\n",
        "# Isolation Forest devuelve -1 para anomalías y 1 para normales. Mapeamos a 1 y 0 respectivamente.\n",
        "y_pred_if = np.where(iso_forest.predict(X_test) == -1, 1, 0)\n",
        "latencia_if = (time.time() - t0) * 1000 # En milisegundos\n",
        "\n",
        "# --- 2. MODELO: ONE-CLASS SVM ---\n",
        "print(\"Entrenando One-Class SVM (muestra reducida por costo computacional)...\")\n",
        "# One-Class SVM puede ser lento en datasets grandes, usamos una submuestra para entrenamiento\n",
        "t0 = time.time()\n",
        "oc_svm = OneClassSVM(nu=contaminacion, kernel='rbf', gamma='scale')\n",
        "oc_svm.fit(X_train[y_train == 0].sample(10000, random_state=42)) # Solo transacciones normales\n",
        "tiempo_entrenamiento_svm = time.time() - t0\n",
        "\n",
        "# Inferencia y toma de tiempos\n",
        "t0 = time.time()\n",
        "y_pred_svm = np.where(oc_svm.predict(X_test) == -1, 1, 0)\n",
        "latencia_svm = (time.time() - t0) * 1000 # En milisegundos\n",
        "\n",
        "# --- 3. MODELO: AUTOENCODER (DEEP LEARNING) ---\n",
        "print(\"Entrenando Autoencoder...\")\n",
        "# Los autoencoders se entrenan únicamente con datos normales\n",
        "X_train_normal = X_train[y_train == 0]\n",
        "\n",
        "input_dim = X_train.shape[1]\n",
        "input_layer = Input(shape=(input_dim,))\n",
        "# Arquitectura Codificadora\n",
        "encoded = Dense(16, activation='relu')(input_layer)\n",
        "encoded = Dense(8, activation='relu')(encoded)\n",
        "# Arquitectura Decodificadora\n",
        "decoded = Dense(16, activation='relu')(encoded)\n",
        "decoded = Dense(input_dim, activation='linear')(decoded)\n",
        "\n",
        "autoencoder = Model(inputs=input_layer, outputs=decoded)\n",
        "autoencoder.compile(optimizer='adam', loss='mse')\n",
        "\n",
        "# Entrenamiento con Early Stopping\n",
        "t0 = time.time()\n",
        "early_stop = EarlyStopping(monitor='val_loss', patience=3, restore_best_weights=True)\n",
        "history = autoencoder.fit(\n",
        "    X_train_normal, X_train_normal,\n",
        "    epochs=15,\n",
        "    batch_size=128,\n",
        "    validation_split=0.1,\n",
        "    callbacks=[early_stop],\n",
        "    verbose=0\n",
        ")\n",
        "tiempo_entrenamiento_ae = time.time() - t0\n",
        "\n",
        "# Inferencia y cálculo de error de reconstrucción\n",
        "t0 = time.time()\n",
        "reconstructions = autoencoder.predict(X_test, verbose=0)\n",
        "mse_reconstruccion = np.mean(np.power(X_test - reconstructions, 2), axis=1)\n",
        "# Umbral para clasificar anomalías basado en el percentil esperado\n",
        "umbral_ae = np.percentile(mse_reconstruccion, 100 * (1 - contaminacion))\n",
        "y_pred_ae = np.where(mse_reconstruccion > umbral_ae, 1, 0)\n",
        "latencia_ae = (time.time() - t0) * 1000\n",
        "\n",
        "# Función para evaluar métricas de desempeño\n",
        "def evaluar_modelo(y_true, y_pred, scores, nombre, latencia):\n",
        "    precision, recall, f1, _ = precision_recall_fscore_support(y_true, y_pred, average='binary')\n",
        "    auc_roc = roc_auc_score(y_true, scores) if scores is not None else roc_auc_score(y_true, y_pred)\n",
        "\n",
        "    # Precision-Recall Curve (PR-AUC)\n",
        "    if scores is not None:\n",
        "        p_curve, r_curve, _ = precision_recall_curve(y_true, scores)\n",
        "        auc_pr = auc(r_curve, p_curve)\n",
        "    else:\n",
        "        auc_pr = f1 # Aproximación simplificada si no hay scores continuos\n",
        "\n",
        "    resultados_modelos[nombre] = {\n",
        "        'Precision': round(precision, 4),\n",
        "        'Recall': round(recall, 4),\n",
        "        'F1-Score': round(f1, 4),\n",
        "        'AUC-ROC': round(auc_roc, 4),\n",
        "        'AUC-PR': round(auc_pr, 4),\n",
        "        'Latencia Inferencia (ms)': round(latencia, 2)\n",
        "    }\n",
        "\n",
        "# Evaluando todos los modelos\n",
        "evaluar_modelo(y_test, y_pred_if, iso_forest.decision_function(X_test), 'Isolation Forest', latencia_if)\n",
        "evaluar_modelo(y_test, y_pred_svm, oc_svm.decision_function(X_test), 'One-Class SVM', latencia_svm)\n",
        "evaluar_modelo(y_test, y_pred_ae, mse_reconstruccion, 'Autoencoder (Densa)', latencia_ae)\n",
        "\n",
        "# Convertir resultados a un DataFrame para comparación directa\n",
        "df_comparativo = pd.DataFrame(resultados_modelos).T\n",
        "display(df_comparativo)"
      ],
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Entrenando Isolation Forest...\n",
            "Entrenando One-Class SVM (muestra reducida por costo computacional)...\n",
            "Entrenando Autoencoder...\n"
          ]
        },
